ip access-list extended GUEST-IN
 permit udp any eq bootpc any eq bootps
 permit udp any any eq 53
 deny ip any 192.168.0.0 0.0.255.255
 deny ip any 10.0.0.0 0.255.255.255
 deny ip any 172.16.0.0 0.15.255.255
 permit ip any any
!
interface vlan 90
 ip access-group GUEST-IN in
!
ip access-list extended PROTECT-HR-ACCT
 permit tcp any any established
 permit ip 192.168.2.0 0.0.0.63 any
 permit ip 192.168.2.192 0.0.0.15 any
 permit ip 192.168.2.224 0.0.0.7 any
 deny ip any any
!
interface vlan 20
 ip access-group PROTECT-HR-ACCT out
interface vlan 30
 ip access-group PROTECT-HR-ACCT out
!
ip access-list extended PROTECT-MGMT
 permit tcp any any established
 permit ip 192.168.2.0 0.0.0.63 any
 deny ip any any
!
interface vlan 99
 ip access-group PROTECT-MGMT out
!
