        <mxCell id="new-20" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=10;spacing=6;overflow=hidden;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Shared VLANs&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;2&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;width:100%&quot;&gt;&lt;tr style=&quot;background:#dbe8f5&quot;&gt;&lt;th align=&quot;left&quot;&gt;VLAN&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Name&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Subnet&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Gateway&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Where&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;VOICE&lt;/td&gt;&lt;td&gt;192.168.1.0/25&lt;/td&gt;&lt;td&gt;.1&lt;/td&gt;&lt;td&gt;phones (voice VLAN)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;80&lt;/td&gt;&lt;td&gt;STAFF-WIFI&lt;/td&gt;&lt;td&gt;192.168.0.0/24&lt;/td&gt;&lt;td&gt;.1&lt;/td&gt;&lt;td&gt;AP-01, AP-02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;90&lt;/td&gt;&lt;td&gt;GUEST&lt;/td&gt;&lt;td&gt;192.168.1.128/25&lt;/td&gt;&lt;td&gt;.129&lt;/td&gt;&lt;td&gt;AP-01, AP-02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;100&lt;/td&gt;&lt;td&gt;PRINTERS-IOT&lt;/td&gt;&lt;td&gt;192.168.2.160/27&lt;/td&gt;&lt;td&gt;.161&lt;/td&gt;&lt;td&gt;18 printers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;110&lt;/td&gt;&lt;td&gt;SERVERS&lt;/td&gt;&lt;td&gt;192.168.2.224/29&lt;/td&gt;&lt;td&gt;.225&lt;/td&gt;&lt;td&gt;ACC-03 Fa0/17-20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;99&lt;/td&gt;&lt;td&gt;MGMT&lt;/td&gt;&lt;td&gt;10.10.0.0/27&lt;/td&gt;&lt;td&gt;.1&lt;/td&gt;&lt;td&gt;switches, APs, UPS&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="180" width="420" x="-415" y="745" as="geometry" />
        </mxCell>
        <mxCell id="new-21" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=10;spacing=6;overflow=hidden;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Transit, WAN and services&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:14px&quot;&gt;&lt;li&gt;WAN 203.0.113.0/30: RTR Gi0/0/0 .2, ISP-STUB .1&lt;/li&gt;&lt;li&gt;Transit 10.10.0.32/30: RTR Gi0/0/1 .33, Core Gi0/1 .34&lt;/li&gt;&lt;li&gt;Inter-building 10.10.0.36/30: RTR Gi0/0/2 .37, BLD2-RTR-01 Gi0/0/0 .38&lt;/li&gt;&lt;li&gt;OSPFv2 process 1, area 0, MD5; user VLANs passive; edge router originates default route&lt;/li&gt;&lt;li&gt;NAT/PAT for 192.168.0.0/22 out Gi0/0/0&lt;/li&gt;&lt;li&gt;DHCP: one central server on the core (all pools). BLD2-RTR-01 relays to 10.10.0.1. DNS 192.168.2.226, domain campus.lab&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="180" width="400" x="10" y="745" as="geometry" />
        </mxCell>
        <mxCell id="new-22" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=10;spacing=6;overflow=hidden;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Legend and Packet Tracer notes&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:14px&quot;&gt;&lt;li&gt;Solid line: Ethernet link. Dashed line: OSPF adjacency.&lt;/li&gt;&lt;li&gt;Access uplinks: 2-link LACP port channels Po1-Po5 (core Fa0/1-10 to access Gi0/1-2), trunk, native VLAN 999, 100 Mbps in Packet Tracer&lt;/li&gt;&lt;li&gt;Server icon on ACC-03 Fa0/24 stands in for BLD1-UPS-01 (Packet Tracer has no UPS)&lt;/li&gt;&lt;li&gt;Models: ISR4331 routers, 3560-24PS core, 2960-24TT access&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="180" width="395" x="425" y="745" as="geometry" />
        </mxCell>
        <mxCell id="new-23" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=10;spacing=6;overflow=hidden;" value="&lt;b style=&quot;font-size:11px&quot;&gt;Building 2 subnets&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;2&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:10px;width:100%&quot;&gt;&lt;tr style=&quot;background:#dbe8f5&quot;&gt;&lt;th align=&quot;left&quot;&gt;VLAN&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Name&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Subnet&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Gateway&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;120&lt;/td&gt;&lt;td&gt;LOGISTICS&lt;/td&gt;&lt;td&gt;192.168.3.0/27&lt;/td&gt;&lt;td&gt;.1 (RTR Gi0/0/1.120)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;99&lt;/td&gt;&lt;td&gt;MGMT-B2&lt;/td&gt;&lt;td&gt;10.10.0.40/29&lt;/td&gt;&lt;td&gt;.41 (RTR Gi0/0/1.99)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;ul style=&quot;margin:6px 0 0 0;padding-left:14px&quot;&gt;&lt;li&gt;20 Logistics users on ACC-01 Fa0/1-20, DHCP from BLD2-RTR-01&lt;/li&gt;&lt;li&gt;ACL LOGISTICS-IN on Gi0/0/1.120&lt;/li&gt;&lt;li&gt;Fa0/21-24 unused, shut down&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="945" y="520" as="geometry" />
        </mxCell>
